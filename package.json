{
  "name": "doctor-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Doctor Hub MERN healthcare application",
  "scripts": {
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
